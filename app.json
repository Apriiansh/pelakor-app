{
  "expo": {
    "name": "pelakor-app",
    "slug": "pelakor-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-kabupaten-ogan-ilir.png",
    "scheme": "pelakorapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.umumoi.pelakor"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo-kabupaten-ogan-ilir.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-kabupaten-ogan-ilir.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "70d9fb16-7010-45c1-8e91-949656c8fb42"
      }
    },
    "owner": "apri27"
  }
}
